MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=Cluster

# Frontend origin(s) allowed by CORS + Socket.IO. Comma-separate several.
CLIENT_URL=http://localhost:5173

# Auth cookie policy
#   lax  -> client and API on the same site (e.g. localhost dev)  [default]
#   none -> client and API on different domains (e.g. Vercel + Render); requires HTTPS
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production. Set false only for plain-HTTP deployments.
# COOKIE_SECURE=false

CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# Chat attachments go to Cloudinary when it's configured. Set MEDIA_STORAGE=local to keep them
# in backend/uploads/chat instead (used by the tests; handy offline).
# MEDIA_STORAGE=local

JWT_SECRET=your_jwt_secret_here

MAIL_SERVICE=gmail
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
# Sender name shown in the inbox (default: Spawnpoint)
# MAIL_FROM_NAME=Spawnpoint

NODE_ENV=development
PORT=4000

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- Live streaming (mediasoup SFU) ---
# Media (UDP/TCP) goes straight to this port on the backend host — open it in your firewall.
SFU_PORT=44444
# IP browsers send media to. Leave unset to auto-detect this machine's LAN IP (works locally
# and for phones on the same Wi-Fi). In production set it to the server's public IP.
# SFU_ANNOUNCED_IP=203.0.113.10

# --- Push notifications (Web Push / VAPID) ---
# Optional: if unset, keys are generated once and saved to backend/data/vapid.json.
# Generate your own with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
