# URL of the backend API, baked into the build.
#   - Local dev:        http://localhost:4000 (or leave empty to use the Vite dev proxy)
#   - Docker Compose:   leave empty; nginx serves the app and proxies /api, /socket.io and /uploads
#   - Separate domains: https://api.example.com (then set COOKIE_SAMESITE=none on the backend)
VITE_BACKEND_URL="http://localhost:4000"
